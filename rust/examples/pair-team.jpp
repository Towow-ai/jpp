// 配对 → 三路过滤 → 聚合，再让一个组合作为新材料进入第二轮配对（施工件 e、f，组合封闭）。
import "../lib/outcome.jpp";
budget {calls: 30, cost: 0.01, depth: 256};

let needs = ["做一个带登录的网页后台", "搭建订单数据库", "写一篇产品发布稿", "给安卓应用做界面"];
let people = [
    {name: "王工", skills: ["web", "后端"]},
    {name: "李工", skills: ["数据库", "后端"]},
    {name: "赵老师", skills: ["写作"]}
];
let fits = test("成员 b 的技能能完成需求 a 吗？", "fit-pair");

// 第一轮：4 × 3 全配对，按关系题分流，再聚合
let relations = pair(needs, people);
let first = sieve(relations, fits);
let summary = tally(first);
fn show(e) { {need: e.left, person: e.right.name} }

// 第二轮：取第一个被接受的关系，把这个组合当作新材料，与另外两位成员再配对
let combo = accepted(first)[0];
let newcomers = [{name: "李工", skills: ["数据库", "后端"]}, {name: "钱设计", skills: ["UI 设计"]}];
let grows = test("已有组合 a（需求 a.a 与承接成员 a.b）加入新成员 b 后，这个组合整体能更好地完成该需求吗？", "fit-group");
let second = sieve(pair([combo], newcomers), grows);
let summary2 = tally(second);

{round1: {pairs: len(relations.value),
          act: map(accepted(first), show),
          unsure: map(undecided(first), fn(p) { {pair: show(p), cause: p.cause} }),
          count: summary.value.count, exists: summary.value.exists, all: summary.value.all},
 round2: {checked: "第二轮问的是「已成组合 + 新成员」作为一个整体能否完成需求；没有从两两关系推定整体成立",
          combo: show(combo),
          act: map(accepted(second), fn(e) { e.right.name }),
          ignore: map(ignored(second), fn(e) { e.right.name }),
          count: summary2.value.count, exists: summary2.value.exists, all: summary2.value.all,
          combo_round1_exit: map(accepted(second), fn(e) { exit_kind(e.left.exit) })},
 // 未决原样交给调用者（J-05：责任随返回值转交）。summary 已并入 first 的未决；second 的在 summary2 里
 pending: [summary.pending, summary2.pending]}
