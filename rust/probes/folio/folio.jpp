// 探针 2 · 复现 jev-folio-recursive-classifier 的核心能力：沿法律本体的层级树逐级下探，给一份法律文书找到叶子类别。
// 两种下探策略写在同一份程序里，便于对照：
//   A「单路」：每层在直接子类里 K 选一（原仓库每层一道 Choice 的写法），拿不准就停，未决随结果交出；
//   B「多路」：每层对每个子类问一道是非题，所有被接受的子类都往下走（原仓库用 beam 保留多条路）；
//      同一层所有题都落在同一份文书上，同状态融合成一次调用。
// 本体是一棵缩小的 FOLIO 式合同/文书树；原仓库从 OWL 文件解析，这里与文书一起经 `jpp run --input` 交给程序（名字 input，不可信材料）。
import "../../lib/outcome.jpp";
budget {calls: 12, cost: 0.2, depth: 256};

fn children(node) { if has(input.tree, node) { input.tree[node] } else { [] } }
// 深度上限写成字面量 6（loop 的 bound 要字面量才静态可估，W-bound）

// —— 策略 A：单路 K 选一 ——
let which = select("这份法律文书最应归入下列哪一类？", "folio-level");
fn descend_one(d) {
    loop(6, {node: input.root, path: [], stopped: "depth", open: []}, fn(s, i) {
        let options = children(s.node);
        if len(options) == 0 { stop(with(s, "stopped", "leaf")) } else {
            let exit = cut(judge(state(d, {over: options}), which));
            handle(exit, {
                pick: fn(k) { {node: options[k], path: append(s.path, options[k]), stopped: "depth", open: []} },
                // 拿不准：停在当前节点，这份未决交给调用者（原仓库在这里取当前分数最高的猜测继续）
                unsure: fn(u) { stop({node: s.node, path: s.path, stopped: "unsure", open: [u]}) }
            })
        }
    })
}

// —— 策略 B：多路逐子类是非题 ——
let about = form("test", "这段话的内容是否与「{concept}」这个话题相关？", {calib: "form-topic"});
fn descend_all(d) {
    loop(6, {frontier: [input.root], leaves: [], dead: [], open: [], layers: 0}, fn(s, i) {
        let inner = filter(s.frontier, fn(n) { len(children(n)) > 0 });
        let done = filter(s.frontier, fn(n) { len(children(n)) == 0 });
        if len(inner) == 0 { stop(with(s, "leaves", concat(s.leaves, done))) } else {
            // 本层所有「节点 × 子类」一次登记：同一份文书上的题融合成一次调用
            let asked = fold(inner, [], fn(acc, n) { concat(acc, map(children(n), fn(c) { {parent: n, concept: c} })) });
            let rs = sieve([d], about, asked);
            let next = map(accepted(rs), fn(e) { e.fill.concept });
            // 一个内部节点的子类全被否决：这条路走到头，记为 dead（原仓库没有这个去向）
            let dead_here = filter(inner, fn(n) { len(filter(accepted(rs), fn(e) { e.fill.parent == n })) == 0 });
            {frontier: next, leaves: concat(s.leaves, done), dead: concat(s.dead, dead_here), open: concat(s.open, rs.pending), layers: s.layers + 1}
        }
    })
}

// 原仓库把 OCR 文本截到约 500 token 再问；这里给一段文书（input.document）
let a = descend_one(mat(input.document));
let b = descend_all(mat(input.document));
{single_path: {leaf: a.node, path: a.path, stopped: a.stopped, pending: a.open},
 multi_path: {leaves: b.leaves, dead_ends: b.dead, layers: b.layers,
              undecided: b.open}}
