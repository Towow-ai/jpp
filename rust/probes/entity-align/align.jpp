// 探针 3 · 复现 TypeSafe cookbook「Knowledge graph entity alignment」的核心能力：
// 两份啤酒目录的候选对，逐对判断是不是同一产品；三档关系直接对应三个动作（不链接 / 送人工 / 断言 sameAs），
// 另外三道字段题（名字、酒厂、风格是否一致）与关系题同一状态，供人工复核参考。酒精度的比较是算术，在宿主里算。
import "../../lib/outcome.jpp";
budget {calls: 12, cost: 0.2, depth: 256};

// 两份目录经 `jpp run --input` 交给程序（input.catalog_a / input.catalog_b，不可信材料）。
// 候选对：宿主侧的粗筛（酒精度差 ≤ 1.5 度，算术不交给判断器）
fn close_abv(a, b) { abs(a.abv - b.abv) <= 1.5 }
let candidates = pair(input.catalog_a, input.catalog_b, close_abv);

let link = measure("两条实体描述作为产品是什么关系？",
    ["它们描述的是两种不同的产品。",
     "它们描述的是密切相关、可能是也可能不是同一款的产品：变体、特别版，或名字两种理解都说得通。",
     "它们描述的是同一款产品。"], "align-link");
let same_name = test("两条实体写的是同一个啤酒名吗？", "align-name");
let same_brewery = test("两条实体来自同一家酒厂吗？", "align-brewery");
let same_style = test("两条实体描述的是同一种啤酒风格吗？", "align-style");

let outcome_of = ["leave unlinked", "curator queue", "assert sameAs"];

// 字段题只给人工复核看：读成是/否/拿不准；判过而拿不准的显式丢弃并记账（不参与路由），没观察到的（预算、缺席、超时）不能丢（B95），带出口交出
fn hint(exit) {
    handle(exit, {act: fn() { "是" }, ignore: fn() { "否" },
                  unsure: fn(u) { let c = unsure_cause(u); if unobserved_cause(c) { {未决: c, exit: u} } else { consume(u, "drop"); "未决" } }})
}

fn route(e) {
    // 一对上的四道题同一状态：融合成一次调用
    let ex = cut(judge(state(e.item), [link, same_name, same_brewery, same_style]));
    let hints = {name: hint(ex[1]), brewery: hint(ex[2]), style: hint(ex[3])};
    let who = {a: e.left.name, b: e.right.name};
    handle(ex[0], {
        at: fn(level) { {pair: who, outcome: outcome_of[level], hints: hints} },
        // 关系拿不准：也送人工队列，未决责任随记录交给调用者（J-05）
        unsure: fn(u) { {pair: who, outcome: "curator queue", hints: hints, duty: u} }
    })
}

let routed = map(candidates.value, route);
fn count(o) { len(filter(routed, fn(r) { r.outcome == o })) }
{candidates: len(candidates.value), pending: candidates.pending,
 tally: {sameAs: count("assert sameAs"), curator: count("curator queue"), unlinked: count("leave unlinked")},
 routed: routed}
