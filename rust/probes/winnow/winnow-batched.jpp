// 探针 1 变体 · 把一份工具输出的所有块放进同一状态，逐块发题：一份输出一次调用（原仓库的写法）。
// 与 winnow.jpp 同一能力，只换了「块放在哪」：主体从状态移进题面的编号引用。
import "../../lib/outcome.jpp";
budget {calls: 12, cost: 0.2, depth: 256};

let useful = form("test", "状态里编号为 {id} 的输出块，对完成状态里的 task 是否有用？", {calib: "winnow-block"});
let has_error = test("这段工具输出里是否含有报错、失败或异常信息？", "winnow-error");
let min_prune_percent = 20;

fn winnow(result) {
    let blocks = map(range(0, len(result.chunks)), fn(i) { {id: "b" + text(i), text: result.chunks[i]} });
    let whole = mat({task: input.tool_outputs.task, blocks: blocks});
    // 报错题与逐块题同一状态：融合成一次调用
    let rs = sieve([whole], concat([has_error], map(blocks, fn(b) { fill(useful, {id: b.id}) })));
    let err = by_q(rs, 0);
    let folded = map(filter(ignored(rs), fn(e) { e.qi > 0 }), fn(e) { e.qi - 1 });
    let unsure_blocks = map(filter(undecided(rs), fn(e) { e.qi > 0 }), fn(e) { e.qi - 1 });
    let pruned_chars = sum(map(folded, fn(i) { len(result.chunks[i]) }));
    let total = sum(map(result.chunks, fn(c) { len(c) }));
    let open = rs.pending;
    let keep_all = fn(reason) { {id: result.id, reason: reason, text: result.chunks, pruned: [], pending: open} };
    if len(accepted(err)) == 1 { keep_all("error_present") } else {
    if len(err.pending) == 1 { keep_all("error_unsure") } else {
    if pruned_chars * 100 < total * min_prune_percent { keep_all("below_min_prune_ratio") } else {
        {id: result.id, reason: "pruned",
         text: map(range(0, len(blocks)), fn(i) {
             if contains(folded, i) { "[winnow 已折叠 " + text(len(result.chunks[i])) + " 字 · 展开键 " + mat(result.chunks[i]).hash + "]" }
             else { result.chunks[i] } }),
         pruned: folded, uncertain: unsure_blocks,
         archive: map(folded, fn(i) { {key: mat(result.chunks[i]).hash, index: i, text: result.chunks[i]} }),
         pending: open}
    } } }
}

{task: input.tool_outputs.task, results: map(input.tool_outputs.results, winnow)}
