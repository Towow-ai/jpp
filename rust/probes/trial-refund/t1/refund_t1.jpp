// T1 设计者版（步 31-1，施工代理由试写 1 改写：只加 T1 任务书要求的输出，线改由 calib-import 来）。原注：试写 1（阶段评估 ①，Fable，2026-09-24）：从一批客服对话里找出「要求退款且情绪激烈」的对话。
// 只用公开面（README、INTERFACE.md、lib、examples）写成。两道是非题串成两层：
// 第一层筛「要求退款」，第二层只对第一层接受的对话问「情绪激烈」。
// 未决随契约值转交（J-05）；两层各自的未决合在最终 pending 里。
import "../../../lib/outcome.jpp";
budget {calls: 40, cost: 0.05, depth: 256};

let refund = test("这段客服对话里，顾客是否明确提出要退款或退钱？", "cs-refund");
let heated = test("这段客服对话里，顾客的措辞是否情绪激烈（例如愤怒、威胁投诉或曝光、连续质问）？", "cs-heated");

// 第一层：谁要退款
let asked_refund = sieve(input.chats, refund);
// 第二层：只对要退款的对话问情绪；第一层的未决随包带进来
let heated_refund = sieve(asked_refund, heated);
let count = tally(heated_refund);

fn idx(xs) { map(xs, fn(e) { e.index }) }

// 元素的 index 跨层不变，是原始对话编号（B81，步 25-0）
{urgent: map(accepted(heated_refund), fn(e) { {index: e.index, chat: e.item} }),
 refund_calm: map(ignored(heated_refund), fn(e) { {index: e.index, chat: e.item} }),
 no_refund: idx(ignored(asked_refund)),
 // 拿不准的对话交给人工复核：原因写明是哪一层
 review: map(undecided(heated_refund), fn(p) { {index: p.index, cause: p.cause} }),
 urgent_count: count.value.count,
 // T1 (b)：预算停下时没问到的对话，两层各自的 unobserved，编号回到原始对话编号
 unobserved: idx(concat(unobserved(asked_refund), unobserved(heated_refund))),
 pending: count.pending}
